{
  "mcpServers": {
    "ArchicadCaracara": {
      "command": "uvx",
      "args": [
        "--from",
        "caracara-archicad-mcp",
        "caracara-server"
      ]
    },
    "ArchicadCaracaraLocal": {
      "command": "caracara-server",
      "args": [],
      "env": {
        "CARACARA_MCP_HOST": "127.0.0.1",
        "CARACARA_MCP_PORT": "8000"
      }
    }
  }
}
